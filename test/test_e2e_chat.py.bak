    )


# =========================================================
# 07
# =========================================================


def test_single_turn_has_exactly_two_messages(
    client,
    runtime,
):
    """
    Một lượt hoàn chỉnh:

        USER
          ↓
        ASSISTANT

    = 2 messages.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    response = ask(
        client,
        "Hãy giải thích RAG.",
        conversation.conversation_id,
    )

    assert response.status_code == 200

    history = conversation_service.history(
        conversation.conversation_id
    )

    messages = history.messages()

    assert len(messages) == 2

    assert messages[0].is_user()

    assert messages[1].is_assistant()


# =========================================================
# 08
# =========================================================


def test_multi_turn_chat_preserves_memory(
    client,
    runtime,
):
    """
    Hai lượt chat phải tạo:

        USER
        ASSISTANT
        USER
        ASSISTANT

    = 4 messages.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    first_question = (
        "Hành Chính AI là gì?"
    )

    second_question = (
        "Nó hỗ trợ cán bộ như thế nào?"
    )

    response1 = ask(
        client,
        first_question,
        conversation.conversation_id,
    )

    response2 = ask(
        client,
        second_question,
        conversation.conversation_id,
    )

    assert response1.status_code == 200
    assert response2.status_code == 200

    history = conversation_service.history(
        conversation.conversation_id
    )

    messages = history.messages()

    assert len(messages) == 4

    assert messages[0].is_user()
    assert messages[1].is_assistant()
    assert messages[2].is_user()
    assert messages[3].is_assistant()

    assert (
        messages[0].content
        == first_question
    )

    assert (
        messages[2].content
        == second_question
    )


# =========================================================
# 09
# =========================================================


def test_multi_turn_assistant_is_called_twice(
    client,
    runtime,
):
    """
    Hai lượt chat phải gọi AssistantService
    đúng hai lần.
    """

    assistant_service, conversation_service = (
        runtime
    )

    conversation = create_conversation(
        conversation_service
    )

    ask(
        client,
        "Câu hỏi thứ nhất.",
        conversation.conversation_id,
    )

    ask(
        client,
        "Câu hỏi thứ hai.",
        conversation.conversation_id,
    )

    assert (
        assistant_service.call_count
        == 2
    )

    assert assistant_service.questions == [
        "Câu hỏi thứ nhất.",
        "Câu hỏi thứ hai.",
    ]


# =========================================================
# 10
# =========================================================


def test_second_turn_uses_same_conversation(
    client,
    runtime,
):
    """
    Hai lượt phải thuộc cùng một conversation.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    first_question = (
        "Nghị quyết 57 nói về gì?"
    )

    second_question = (
        "Vậy cấp xã cần làm gì?"
    )

    ask(
        client,
        first_question,
        conversation.conversation_id,
    )

    ask(
        client,
        second_question,
        conversation.conversation_id,
    )

    history = conversation_service.history(
        conversation.conversation_id
    )

    messages = history.messages()

    assert len(messages) == 4

    user_messages = [
        message
        for message in messages
        if message.is_user()
    ]

    assert len(user_messages) == 2

    assert (
        user_messages[0].content
        == first_question
    )

    assert (
        user_messages[1].content
        == second_question
    )


