def test_invalid_conversation_id_is_rejected(
    client,
    runtime,
):
    """
    conversation_id không tồn tại phải bị từ chối.
    """

    response = client.post(
        "/assistant/ask",
        json={
            "question": "Hỏi thử.",
            "conversation_id": (
                "conversation-does-not-exist"
            ),
        },
    )

    assert response.status_code >= 400


# =========================================================
# 15
# =========================================================


def test_final_e2e_chat_gate(
    client,
    runtime,
):
    """
    =====================================================
    13.6 FINAL E2E CHAT GATE
    =====================================================

    Một phiên chat thực tế phải chạy xuyên suốt:

        HTTP
          ↓
        /assistant/ask
          ↓
        Conversation
          ↓
        User Message
          ↓
        AssistantService
          ↓
        Assistant Answer
          ↓
        Assistant Message
          ↓
        Memory
          ↓
        Context

    Kiểm tra:

    - 2 HTTP requests thành công
    - Assistant được gọi 2 lần
    - Có đúng 4 messages
    - Đúng thứ tự User / Assistant
    - Đúng nội dung User
    - Context giữ được lịch sử
    - Không rò rỉ conversation
    """

    assistant_service, conversation_service = (
        runtime
    )

    conversation = (
        conversation_service.create(
            title="13.6 E2E Chat Gate",
            user_id="test-user",
        )
    )

    first_question = (
        "Hãy giới thiệu Hành Chính AI."
    )

    second_question = (
        "Nó hỗ trợ cán bộ như thế nào?"
    )

    response1 = ask(
        client,
        first_question,
        conversation.conversation_id,
    )

    response2 = ask(
        client,
        second_question,
        conversation.conversation_id,
    )

    # -----------------------------------------------------
    # HTTP
    # -----------------------------------------------------

    assert response1.status_code == 200

    assert response2.status_code == 200

    # -----------------------------------------------------
    # Assistant
    # -----------------------------------------------------

    assert (
        assistant_service.call_count
        == 2
    )

    assert assistant_service.questions == [
        first_question,
        second_question,
    ]

    # -----------------------------------------------------
    # Response
    # -----------------------------------------------------

    data1 = response1.json()
    data2 = response2.json()

    assert data1["answer"]

    assert data2["answer"]

    # -----------------------------------------------------
    # Memory
    # -----------------------------------------------------

    history = conversation_service.history(
        conversation.conversation_id
    )

    messages = history.messages()

    assert len(messages) == 4

    # -----------------------------------------------------
    # Message order
    # -----------------------------------------------------

    assert messages[0].is_user()

    assert messages[1].is_assistant()

    assert messages[2].is_user()

    assert messages[3].is_assistant()

    # -----------------------------------------------------
    # User content
    # -----------------------------------------------------

    assert (
        messages[0].content
        == first_question
    )

    assert (
        messages[2].content
        == second_question
    )

    # -----------------------------------------------------
    # Assistant content
    # -----------------------------------------------------

    assert messages[1].content

    assert messages[3].content

    # -----------------------------------------------------
    # Context
    # -----------------------------------------------------

    prompt = conversation_service.prompt(
        conversation.conversation_id
    )

    assert first_question in prompt

    assert second_question in prompt

    # -----------------------------------------------------
    # Ordering inside context
    # -----------------------------------------------------

    assert prompt.index(
        first_question
    ) < prompt.index(
        second_question
    )

    # -----------------------------------------------------
    # Final invariant
    # -----------------------------------------------------

    assert history.count() == 4

    assert not history.is_empty()