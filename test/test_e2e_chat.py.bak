"""
Sprint 13.6
E2E Chat

End-to-End Chat Integration Gate.

Pipeline:

    HTTP
      ↓
    /assistant/ask
      ↓
    Conversation
      ↓
    User Message
      ↓
    AssistantService
      ↓
    Assistant Answer
      ↓
    Assistant Message
      ↓
    Conversation Memory
      ↓
    Context / Prompt

Mục tiêu:

1. API /assistant/ask hoạt động.
2. Một lượt chat tạo User + Assistant message.
3. Multi-turn conversation giữ đúng memory.
4. Context của lượt sau chứa lịch sử lượt trước.
5. Conversation được cô lập.
6. Invalid conversation_id bị từ chối.
7. Response contract ổn định.
8. Không gọi AI provider thật.

Không gọi Ollama thật.
Không gọi Gemini thật.
Không phụ thuộc Internet.
"""

from __future__ import annotations

from dataclasses import dataclass
from typing import Any

import pytest
from fastapi.testclient import TestClient

from app.main import app
from app.api.routes.assistant import (
    configure_assistant_service,
)
from app.conversation.conversation_service import (
    ConversationService,
)


# =========================================================
# FAKE ASSISTANT
# =========================================================


@dataclass
class FakeAssistantResponse:
    """
    Response giả lập của AssistantService.
    """

    answer: str
    query: str
    citations: list[Any]
    metadata: dict[str, Any]


class FakeAssistantService:
    """
    Assistant giả lập dùng cho E2E test.

    Không gọi provider thật.

    Đồng thời ghi nhận toàn bộ câu hỏi mà API
    chuyển xuống AssistantService.
    """

    def __init__(self) -> None:
        self.call_count = 0
        self.questions: list[str] = []

    def ask(
        self,
        question: str,
    ) -> FakeAssistantResponse:
        self.call_count += 1

        self.questions.append(question)

        return FakeAssistantResponse(
            answer=(
                f"Đây là câu trả lời kiểm thử cho: "
                f"{question}"
            ),
            query=question,
            citations=[],
            metadata={
                "pipeline_stage": "e2e_test",
                "provider": "fake",
                "citation_count": 0,
            },
        )


# =========================================================
# TEST RUNTIME
# =========================================================


@pytest.fixture
def runtime():
    """
    Tạo runtime độc lập cho mỗi test.

    Tránh dùng state của test khác.
    """

    assistant_service = (
        FakeAssistantService()
    )

    conversation_service = (
        ConversationService()
    )

    configure_assistant_service(
        assistant_service,
        conversation_service=(
            conversation_service
        ),
    )

    yield (
        assistant_service,
        conversation_service,
    )


@pytest.fixture
def client(runtime):
    """
    FastAPI TestClient.
    """

    with TestClient(app) as test_client:
        yield test_client


# =========================================================
# HELPERS
# =========================================================


def create_conversation(
    conversation_service: ConversationService,
):
    """
    Tạo conversation cho test.
    """

    return conversation_service.create(
        title="E2E Chat Test",
        user_id="e2e-test-user",
    )


def ask(
    client: TestClient,
    question: str,
    conversation_id: str,
):
    """
    Gửi câu hỏi tới /assistant/ask.
    """

    return client.post(
        "/assistant/ask",
        json={
            "question": question,
            "conversation_id": conversation_id,
        },
    )


# =========================================================
# 01
# =========================================================


def test_chat_endpoint_is_reachable(
    client,
    runtime,
):
    """
    /assistant/ask phải tồn tại và xử lý request.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    response = ask(
        client,
        "Chuyển đổi số là gì?",
        conversation.conversation_id,
    )

    assert response.status_code == 200


# =========================================================
# 02
# =========================================================


def test_chat_returns_json_response(
    client,
    runtime,
):
    """
    Response phải là JSON.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    response = ask(
        client,
        "Hãy giải thích RAG.",
        conversation.conversation_id,
    )

    assert response.status_code == 200

    content_type = (
        response.headers
        .get("content-type", "")
    )

    assert "application/json" in content_type


# =========================================================
# 03
# =========================================================


def test_chat_response_contains_answer(
    client,
    runtime,
):
    """
    Response phải có answer.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    question = "Hành Chính AI là gì?"

    response = ask(
        client,
        question,
        conversation.conversation_id,
    )

    assert response.status_code == 200

    data = response.json()

    assert "answer" in data

    assert isinstance(
        data["answer"],
        str,
    )

    assert data["answer"]


# =========================================================
# 04
# =========================================================


def test_chat_response_contains_query(
    client,
    runtime,
):
    """
    Response phải trả lại query/question.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    question = "Nghị quyết 57 nói về gì?"

    response = ask(
        client,
        question,
        conversation.conversation_id,
    )

    assert response.status_code == 200

    data = response.json()

    returned_query = (
        data.get("query")
        or data.get("question")
    )

    assert returned_query == question


# =========================================================
# 05
# =========================================================


def test_single_turn_creates_user_message(
    client,
    runtime,
):
    """
    Một lượt chat phải lưu User message.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    question = "Chuyển đổi số là gì?"

    response = ask(
        client,
        question,
        conversation.conversation_id,
    )

    assert response.status_code == 200

    history = conversation_service.history(
        conversation.conversation_id
    )

    user_messages = [
        message
        for message in history.messages()
        if message.is_user()
    ]

    assert len(user_messages) == 1

    assert (
        user_messages[0].content
        == question
    )


