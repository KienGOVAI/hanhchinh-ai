def test_context_after_two_turns_contains_history(
    client,
    runtime,
):
    """
    Sau hai lượt chat, prompt/context của
    conversation phải chứa lịch sử hội thoại.
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    first_question = (
        "Hành Chính AI có những chức năng gì?"
    )

    second_question = (
        "Chức năng nào quan trọng nhất?"
    )

    ask(
        client,
        first_question,
        conversation.conversation_id,
    )

    ask(
        client,
        second_question,
        conversation.conversation_id,
    )

    prompt = conversation_service.prompt(
        conversation.conversation_id
    )

    assert first_question in prompt

    assert second_question in prompt


# =========================================================
# 12
# =========================================================


def test_context_preserves_turn_order(
    client,
    runtime,
):
    """
    Context phải giữ đúng thứ tự:

        Q1
        A1
        Q2
        A2
    """

    _, conversation_service = runtime

    conversation = create_conversation(
        conversation_service
    )

    q1 = "Câu hỏi E2E số một."

    q2 = "Câu hỏi E2E số hai."

    ask(
        client,
        q1,
        conversation.conversation_id,
    )

    ask(
        client,
        q2,
        conversation.conversation_id,
    )

    prompt = conversation_service.prompt(
        conversation.conversation_id
    )

    q1_position = prompt.index(q1)

    q2_position = prompt.index(q2)

    assert q1_position < q2_position


# =========================================================
# 13
# =========================================================


def test_conversations_are_isolated(
    client,
    runtime,
):
    """
    Memory của Conversation A không được
    xuất hiện trong Conversation B.
    """

    _, conversation_service = runtime

    conversation_a = create_conversation(
        conversation_service
    )

    conversation_b = create_conversation(
        conversation_service
    )

    question_a = (
        "Thông tin riêng của conversation A."
    )

    question_b = (
        "Thông tin riêng của conversation B."
    )

    ask(
        client,
        question_a,
        conversation_a.conversation_id,
    )

    ask(
        client,
        question_b,
        conversation_b.conversation_id,
    )

    prompt_a = conversation_service.prompt(
        conversation_a.conversation_id
    )

    prompt_b = conversation_service.prompt(
        conversation_b.conversation_id
    )

    assert question_a in prompt_a
    assert question_a not in prompt_b

    assert question_b in prompt_b
    assert question_b not in prompt_a


